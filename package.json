{
  "name": "arc-lab-blog",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "ARC LAB — 기록하는 개발자 (MinGyu2.github.io) built with Astro",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "migrate": "node scripts/migrate-jekyll.mjs",
    "verify": "npm run verify:site && npm run verify:migration && npm run test:experiments",
    "verify:site": "node scripts/verify-site.mjs",
    "verify:migration": "node scripts/verify-migration.mjs",
    "test:experiments": "node scripts/test-experiments.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.10",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/rajdhani": "5.3.0",
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.13",
    "shiki": "4.6.0",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "24.19.2",
    "pagefind": "1.6.0",
    "satteri": "0.11.7",
    "typescript": "6.0.3",
    "yaml": "2.9.1"
  }
}
