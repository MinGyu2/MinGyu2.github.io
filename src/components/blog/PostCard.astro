---
import { excerptOf, formatDate, readingMinutes, displayTitle, logCode, getPosts, classificationOf, type Post } from '../../lib/posts';
interface Props {
  post: Post;
  variant?: 'hud' | 'clean';
  headingLevel?: 2 | 3;
  maxTags?: number;
}
const { post, variant = 'clean', headingLevel = 3, maxTags = 4 } = Astro.props;
const posts = await getPosts();
const cls = classificationOf(post);
const mod = { color: cls.module.color, label: `${cls.module.short} · ${cls.submodule.ko}` };
const seriesLabel = post.data.series ? `#${String(post.data.series.order).padStart(2, '0')}` : '';
const code = logCode(post, posts);
const minutes = readingMinutes(post);
const summary = excerptOf(post);
const title = displayTitle(post);
const tags = post.data.tags.slice(0, maxTags);
const H = `h${headingLevel}` as 'h2' | 'h3';
const date = formatDate(post.data.date);
---
{
  variant === 'hud' ? (
    <article class="hud-frame hud-frame-interactive post-card h-full">
      <div class="hud-panel-inner p-5 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between gap-2 mb-2.5 font-mono-code text-micro">
            <span class="flex items-center gap-1.5 min-w-0 t-muted">
              <span class="w-2 h-2 rounded-full shrink-0" style={`background:${mod.color}`} aria-hidden="true" />
              <span class="truncate">{code} · {mod.label}{seriesLabel && ` · ${seriesLabel}`}</span>
            </span>
            <span class="t-muted shrink-0">{minutes}분</span>
          </div>
          <H class="text-card font-semibold t-heading mb-2">
            <a href={post.data.legacyPath} class="post-card-link">{title}</a>
          </H>
          <p class="text-desc t-body line-clamp-3">{summary}</p>
        </div>
        <div class="mt-4 pt-3 border-t b-circuit-soft flex items-center justify-between gap-2">
          <ul class="flex flex-wrap gap-1.5 min-w-0" aria-label="태그">
            {tags.map((t) => <li class="chip">#{t}</li>)}
          </ul>
          <time class="font-mono-code text-micro t-muted shrink-0" datetime={post.data.date.toISOString()}>{date}</time>
        </div>
      </div>
    </article>
  ) : (
    <article class="clean-card clean-card-interactive post-card p-5 flex flex-col justify-between h-full">
      <div>
        <div class="flex items-center justify-between font-mono-code text-micro mb-2 gap-2">
          <span class="flex items-center gap-1.5 min-w-0 t-muted">
            <span class="w-2 h-2 rounded-full shrink-0" style={`background:${mod.color}`} aria-hidden="true" />
            <span class="truncate">{code} · {mod.label}{seriesLabel && ` · ${seriesLabel}`}</span>
          </span>
          <span class="t-muted shrink-0">
            <time datetime={post.data.date.toISOString()}>{date}</time> · {minutes}분
          </span>
        </div>
        <H class="text-card font-semibold t-heading">
          <a href={post.data.legacyPath} class="post-card-link">{title}</a>
        </H>
        <p class="text-desc t-body mt-2 line-clamp-3">{summary}</p>
      </div>
      <div class="mt-4 pt-3 border-t b-circuit-soft flex items-center justify-between gap-2">
        <ul class="flex flex-wrap gap-1.5 min-w-0" aria-label="태그">
          {tags.map((t) => <li class="chip">#{t}</li>)}
          {post.data.tags.length > maxTags && <li class="chip">+{post.data.tags.length - maxTags}</li>}
        </ul>
        <span class="font-mono-code text-micro t-cyan shrink-0" aria-hidden="true">읽기 -&gt;</span>
      </div>
    </article>
  )
}

<style>
  /* Whole card is clickable via the title link's stretched hit area. */
  .post-card {
    position: relative;
  }
  .post-card-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .post-card-link:focus-visible {
    outline: none;
  }
  .post-card:has(.post-card-link:focus-visible) {
    outline: 2px solid var(--accent-primary);
    outline-offset: 3px;
  }
  .post-card-link:hover {
    color: var(--accent-primary);
  }
  .hud-frame.post-card:has(.post-card-link:hover),
  .hud-frame.post-card:has(.post-card-link:focus-visible) {
    transform: translateY(-2px);
    filter: var(--hover-drop);
  }
  .hud-frame.post-card:has(.post-card-link:hover) .hud-panel-inner,
  .hud-frame.post-card:has(.post-card-link:focus-visible) .hud-panel-inner {
    border-color: var(--accent-primary);
  }
</style>
