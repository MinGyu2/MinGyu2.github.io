---
/** Subtle static circuit trace in the page background (hidden in the reader). */
---
<div class="bg-circuit-decor" aria-hidden="true">
  <svg class="absolute top-20 right-4 w-72 h-72 opacity-20" viewBox="0 0 240 240" fill="none">
    <path d="M20 40 H110 L130 60 H220" stroke="var(--circuit-line)" stroke-width="1"></path>
    <path d="M60 80 H150 L170 100 H220" stroke="var(--accent-primary)" stroke-width="0.9" stroke-dasharray="4 4"></path>
    <circle cx="110" cy="40" r="3" fill="var(--accent-primary)"></circle>
    <circle cx="170" cy="100" r="3" fill="var(--circuit-line)"></circle>
    <path d="M190 120 V190 L165 215 H90" stroke="var(--circuit-line)" stroke-width="1"></path>
    <circle cx="190" cy="120" r="2.5" fill="var(--accent-secondary)"></circle>
  </svg>
</div>
