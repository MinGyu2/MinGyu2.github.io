---
/** Mechanical arc core brand emblem (decorative unless a label is given). */
interface Props {
  size?: number;
  label?: string;
  class?: string;
}
const { size = 40, label, class: className } = Astro.props;
---
<svg
  viewBox="0 0 48 48"
  width={size}
  height={size}
  class={className}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  {label && <title>{label}</title>}
  <circle cx="24" cy="24" r="21" fill="none" stroke="var(--circuit-line)" stroke-width="1.2"></circle>
  <path d="M24 3 A21 21 0 0 1 42.2 13.5" fill="none" stroke="var(--accent-primary)" stroke-width="2" stroke-linecap="round"></path>
  <path d="M42.2 34.5 A21 21 0 0 1 24 45" fill="none" stroke="var(--accent-primary)" stroke-width="2" stroke-linecap="round"></path>
  <path d="M5.8 34.5 A21 21 0 0 1 5.8 13.5" fill="none" stroke="var(--accent-secondary)" stroke-width="1.8" stroke-linecap="round"></path>
  <line x1="24" y1="7" x2="24" y2="12" stroke="var(--accent-primary)" stroke-width="1.4"></line>
  <line x1="24" y1="36" x2="24" y2="41" stroke="var(--accent-primary)" stroke-width="1.4"></line>
  <line x1="7" y1="24" x2="12" y2="24" stroke="var(--circuit-line)" stroke-width="1.4"></line>
  <line x1="36" y1="24" x2="41" y2="24" stroke="var(--circuit-line)" stroke-width="1.4"></line>
  <polygon points="24,13 33.5,18.5 33.5,29.5 24,35 14.5,29.5 14.5,18.5" fill="var(--accent-primary-soft)" stroke="var(--accent-primary)" stroke-width="1.4"></polygon>
  <circle cx="24" cy="24" r="4.2" fill="var(--accent-primary)"></circle>
  <circle cx="24" cy="24" r="1.6" fill="var(--bg-canvas)"></circle>
</svg>
