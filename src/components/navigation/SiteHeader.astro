---
import ArcEmblem from '../hud/ArcEmblem.astro';
import { NAV_ITEMS, type NavId } from '../../lib/site';

interface Props {
  active?: NavId;
}
const { active } = Astro.props;
---
<header class="site-header" id="site-header">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 min-h-16 py-2 flex items-center justify-between gap-3">
    <a href="/" class="flex items-center gap-2.5 shrink-0 group rounded" aria-label="ARC LAB 홈 (기록하는 개발자)">
      <ArcEmblem size={40} class="shrink-0" />
      <span class="whitespace-nowrap">
        <span class="flex items-center gap-2">
          <span class="font-hud text-xl font-bold tracking-wider t-heading group-hover:opacity-85 transition-opacity">ARC LAB</span>
          <span class="brand-version-badge font-mono-code text-micro px-1.5 py-0.5 badge-cyan rounded-sm">LAB.02</span>
        </span>
        <span class="block text-meta t-muted leading-none mt-1">기록하는 개발자</span>
      </span>
    </a>

    <nav class="desktop-nav items-center gap-1 shrink-0" aria-label="주요 메뉴">
      {
        NAV_ITEMS.map((item) => (
          <a
            href={item.href}
            class="nav-btn px-2.5 py-1.5 rounded border border-transparent whitespace-nowrap"
            aria-current={active === item.id ? 'page' : undefined}
          >
            <span class="block font-hud text-desc font-semibold uppercase tracking-wider leading-tight">{item.label}</span>
            <span class="nav-ko block text-meta leading-tight mt-0.5">{item.ko}</span>
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2 shrink-0">
      <button
        type="button"
        class="btn-outline px-3 py-1.5 rounded text-xs whitespace-nowrap min-h-11 min-w-11"
        data-search-open
        aria-haspopup="dialog"
        aria-controls="search-dialog"
        aria-keyshortcuts="Control+K Meta+K"
        aria-label="전역 검색 열기"
      >
        <svg class="w-4 h-4 t-cyan shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path>
        </svg>
        <span class="search-btn-label text-sm t-body">검색</span>
        <kbd class="search-kbd-hint font-mono-code text-micro px-1.5 py-0.5 rounded border b-circuit t-cyan bg-panel" data-kbd-hint>Ctrl K</kbd>
      </button>

      <button type="button" class="btn-outline rounded w-11 h-11 min-h-11 p-0" id="theme-toggle" aria-label="테마 전환">
        <svg class="theme-icon-moon w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
        <svg class="theme-icon-sun w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="5"></circle>
          <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path>
        </svg>
      </button>

      <button
        type="button"
        id="mobile-menu-btn"
        class="mobile-menu-trigger btn-outline rounded w-11 h-11 min-h-11 p-0"
        aria-label="메뉴 열기"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="mobile-menu border-t b-circuit px-4 py-3" aria-label="모바일 메뉴" hidden>
    <ul class="grid grid-cols-2 gap-2">
      {
        NAV_ITEMS.map((item) => (
          <li>
            <a
              href={item.href}
              class="mobile-nav-link block px-3.5 py-2.5 rounded border b-circuit bg-inset"
              aria-current={active === item.id ? 'page' : undefined}
            >
              <span class="block text-desc font-semibold t-heading">{item.ko}</span>
              <span class="block font-hud text-meta font-semibold t-muted uppercase tracking-wider">{item.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .mobile-menu {
    background: var(--bg-canvas);
  }
  .mobile-nav-link[aria-current='page'] {
    border-color: var(--accent-primary);
    background: var(--accent-primary-soft);
  }
  .mobile-nav-link:hover {
    border-color: var(--accent-primary);
  }
  /* Korean destination name: readable but secondary to the HUD label; follows hover/current. */
  .nav-ko {
    color: var(--text-muted);
  }
  .nav-btn:hover .nav-ko,
  .nav-btn[aria-current='page'] .nav-ko {
    color: inherit;
  }
  :global(html[data-theme='light']) .theme-icon-sun,
  :global(html:not([data-theme='light'])) .theme-icon-moon {
    display: none;
  }
</style>

<script>
  import { applyTheme, currentTheme } from '../../scripts/theme';

  const toggle = document.getElementById('theme-toggle');
  const syncToggle = () => {
    const theme = currentTheme();
    const next = theme === 'dark' ? '라이트' : '다크';
    toggle?.setAttribute('aria-label', `${next} 테마로 전환 (현재: ${theme === 'dark' ? '다크' : '라이트'})`);
  };
  syncToggle();
  toggle?.addEventListener('click', () => {
    applyTheme(currentTheme() === 'dark' ? 'light' : 'dark', true);
    syncToggle();
  });

  // Mobile navigation drawer
  const menuBtn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const setMenu = (open: boolean, returnFocus = false) => {
    if (!menu || !menuBtn) return;
    menu.hidden = !open;
    menuBtn.setAttribute('aria-expanded', String(open));
    menuBtn.setAttribute('aria-label', open ? '메뉴 닫기' : '메뉴 열기');
    if (open) menu.querySelector<HTMLAnchorElement>('a')?.focus();
    else if (returnFocus) menuBtn.focus();
  };
  menuBtn?.addEventListener('click', () => setMenu(menu?.hidden !== false));
  menu?.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setMenu(false, true);
  });
  document.addEventListener('click', (e) => {
    if (!menu || menu.hidden) return;
    const t = e.target as Node;
    if (!menu.contains(t) && !menuBtn?.contains(t)) setMenu(false);
  });
  window.matchMedia('(min-width: 68.8125em)').addEventListener('change', (e) => {
    if (e.matches) setMenu(false);
  });

  // Platform-appropriate shortcut hint
  if (/Mac|iPhone|iPad/.test(navigator.platform)) {
    document.querySelectorAll('[data-kbd-hint]').forEach((el) => (el.textContent = '⌘ K'));
  }
</script>
