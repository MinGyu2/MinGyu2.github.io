---
/**
 * Experiment Lab — catalog and launcher only. No experiment is rendered or executed here;
 * each one opens on its own page (Astro tool route or public/experiments/<path>/).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import HudPanel from '../../components/hud/HudPanel.astro';
import CatalogNode from '../../components/lab/CatalogNode.astro';
import { getExperimentCatalog } from '../../lib/experiments';

const catalog = getExperimentCatalog();
const { counts } = catalog;
const rootGroups = catalog.roots.filter((n) => n.kind === 'group');
const rootExperiments = catalog.roots.filter((n) => n.kind === 'experiment');
const pad = (n: number) => String(n).padStart(2, '0');
---
<BaseLayout title="Experiment Lab · 실험실" nav="lab" view="lab" description="브라우저에서 바로 실행하는 실험 도구와 시뮬레이션 모음">
  <script is:inline slot="head">
    // Legacy link: /lab/#payload-inspector → dedicated route (only this exact fragment).
    if (location.hash === '#payload-inspector') location.replace('/lab/payload-inspector/');
  </script>
  <div class="space-y-6 reveal" data-pagefind-body>
    <span hidden data-pagefind-meta="type">LAB</span>
    <span hidden data-pagefind-meta="sub">EXPERIMENT LAB · 실험 카탈로그</span>

    <HudPanel innerClass="p-6 p-pad">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div class="max-w-2xl">
          <span class="panel-id">LAB // EXPERIMENT CATALOG</span>
          <h1 class="font-hud text-2xl sm:text-3xl font-bold t-heading mt-1">Experiment Lab</h1>
          <p class="text-sm t-muted mt-1.5 leading-relaxed">
            보안 실습 도구와 독립 실행형 HTML · Canvas · WebGL · WebAssembly 실험을 모아 둔 실험실입니다. 그룹을 펼쳐 실험을 확인하고, 원하는 실험만 직접 실행하세요.
          </p>
        </div>
        <dl class="lab-stats" aria-label="실험 현황">
          <div><dt>TOTAL</dt><dd class="t-heading" data-lab-count="total">{pad(counts.total)}</dd></div>
          <div><dt>AVAILABLE</dt><dd class="t-mint" data-lab-count="available">{pad(counts.available)}</dd></div>
          <div><dt>IN DEV</dt><dd class="t-cyan" data-lab-count="in-development">{pad(counts.inDevelopment)}</dd></div>
          <div><dt>PLANNED</dt><dd class="t-amber" data-lab-count="planned">{pad(counts.planned)}</dd></div>
          <div><dt>GROUPS</dt><dd class="t-blue" data-lab-count="groups">{pad(counts.groups)}</dd></div>
        </dl>
      </div>
    </HudPanel>

    {
      counts.total === 0 ? (
        <div class="clean-card p-10 text-center">
          <p class="font-mono-code text-sm t-amber">등록된 실험이 없습니다</p>
          <p class="text-sm t-muted mt-2">public/experiments/&lt;폴더&gt;/index.html 을 추가하고 다시 빌드하면 자동으로 표시됩니다.</p>
        </div>
      ) : (
        <>
          <div class="clean-card p-4 flex flex-wrap items-center gap-3 js-only" data-pagefind-ignore>
            <label for="lab-search" class="sr-only">실험 검색 (제목, 설명, 태그, 그룹, 경로)</label>
            <input id="lab-search" type="search" autocomplete="off" placeholder="실험 검색 — 제목, 설명, 태그, 그룹, 경로..." class="field px-3.5 py-2.5 text-sm flex-1 min-w-[12rem]" />
            <button type="button" class="btn-outline px-3 rounded text-xs min-h-10" id="lab-search-clear" hidden>
              검색 지우기
            </button>
            <p id="lab-result-count" class="font-mono-code text-[11px] t-muted" role="status" aria-live="polite">
              {counts.total} EXPERIMENTS
            </p>
          </div>

          {
            rootGroups.length > 0 && (
              <section aria-labelledby="lab-groups-title">
                <h2 id="lab-groups-title" class="panel-id mb-3">
                  GROUPS // 실험 그룹 ({rootGroups.length})
                </h2>
                <ul class="space-y-3" data-lab-tree>
                  {rootGroups.map((n) => (
                    <CatalogNode node={n} />
                  ))}
                </ul>
              </section>
            )
          }

          {
            rootExperiments.length > 0 && (
              <section aria-labelledby="lab-root-title" data-lab-root-section>
                <h2 id="lab-root-title" class="panel-id mb-3">
                  STANDALONE // 독립 실험 ({rootExperiments.length})
                </h2>
                <ul class="lab-root-grid">
                  {rootExperiments.map((n) => (
                    <CatalogNode node={n} />
                  ))}
                </ul>
              </section>
            )
          }

          <div class="clean-card p-10 text-center" id="lab-no-results" hidden>
            <p class="font-mono-code text-sm t-amber">검색과 일치하는 실험이 없습니다</p>
            <p class="text-sm t-muted mt-2">다른 키워드로 찾거나 검색을 지워 전체 목록을 확인하세요.</p>
            <button type="button" class="btn-outline px-4 py-2 text-sm rounded mt-4" data-lab-clear>
              검색 지우기
            </button>
          </div>
        </>
      )
    }

    <p class="text-[12px] t-muted leading-relaxed" data-pagefind-ignore>
      새 실험은 <code class="font-mono-code t-cyan">public/experiments/&lt;그룹&gt;/&lt;실험&gt;/index.html</code> 로 추가하면 다음 빌드에서 자동으로 이 목록에 나타납니다. 무거운 런타임(WebGL, WASM 등)은 해당
      실험 페이지를 실행할 때만 불러옵니다.
    </p>
  </div>
</BaseLayout>

<style>
  .lab-stats {
    display: grid;
    grid-template-columns: repeat(5, minmax(4.5rem, auto));
    gap: 0.5rem;
  }
  .lab-stats > div {
    padding: 0.5rem 0.75rem;
    background: var(--bg-inset);
    border: 1px solid var(--circuit-line-soft);
    border-radius: 4px;
  }
  .lab-stats dt {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }
  .lab-stats dd {
    font-family: var(--font-hud);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.2;
  }
  .lab-root-grid {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
  }
  @media (max-width: 640px) {
    .lab-stats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      width: 100%;
    }
  }
</style>

<script>
  import { initLabCatalog } from '../../scripts/lab-catalog';
  initLabCatalog();
</script>
