---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import HudPanel from '../../../components/hud/HudPanel.astro';
import PayloadInspector from '../../../components/lab/PayloadInspector.astro';
import { getExperimentCatalog } from '../../../lib/experiments';

const tool = getExperimentCatalog().experiments.find((e) => e.id === 'payload-inspector');
if (!tool) throw new Error('Payload Inspector is missing from the experiment catalog');
---
<BaseLayout title={`${tool.title} · Experiment Lab`} nav="lab" view="lab" description={tool.description}>
  <div class="space-y-6 reveal" data-pagefind-body>
    <span hidden data-pagefind-meta="type">LAB</span>
    <span hidden data-pagefind-meta="sub">{`${tool.code} · Payload Inspector · Base64 / URL / Hex`}</span>
    <nav aria-label="실험실 위치" class="flex flex-wrap items-center justify-between gap-3">
      <a href="/lab/" class="btn-outline px-3.5 py-1.5 rounded text-sm min-h-11">&lt;- Experiment Lab 목록</a>
      <span class="font-mono-code text-xs t-muted">LAB // {tool.code} // {tool.id}</span>
    </nav>
    <HudPanel innerClass="p-6 p-pad flex flex-wrap items-center justify-between gap-3">
      <div>
        <span class="panel-id">{tool.code} // DIAGNOSTIC SANDBOX</span>
        <h1 class="font-hud text-2xl sm:text-3xl font-bold t-heading mt-1">{tool.title}</h1>
        <p class="text-sm t-muted mt-1">웹 보안 실습과 디버깅 중 문자열의 Base64 · URL · Hex 변환과 바이트 · 문자 수를 실시간으로 확인합니다.</p>
      </div>
      <span class="font-mono-code text-xs px-2.5 py-1 badge-cyan rounded-sm">MODULE: ENCODER v1</span>
    </HudPanel>

    <PayloadInspector />
  </div>
</BaseLayout>
