---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HudPanel from '../../components/hud/HudPanel.astro';
import { formatDate, getModuleStats, getPosts } from '../../lib/posts';
import { SITE } from '../../lib/site';
import { PROJECTS } from '../../data/projects';

const posts = await getPosts();
const stats = await getModuleStats();
const first = posts[posts.length - 1];
const latest = posts[0];
const series = PROJECTS[0];
const sub = (m: string, id: string) => stats.all.find((x) => x.id === m)?.submodules.find((x) => x.id === id)?.count ?? 0;
const mod = (m: string) => stats.all.find((x) => x.id === m)?.count ?? 0;
const interests = [
  {
    code: 'WEB SECURITY',
    tone: 't-cyan',
    text: '모의해킹 수업과 실습 — SQL Injection, XSS, CSRF, SSRF, File Upload, Log4Shell',
    href: '/posts/?module=security&submodule=web-security',
    meta: `Web Security ${sub('security', 'web-security')}`,
  },
  {
    code: 'SECURITY LAB',
    tone: 't-mint',
    text: '웹 취약점 실습을 위해 Nginx · Tomcat(Servlet/JSP) · Oracle DB 웹 서버를 직접 구축한 연재',
    href: '/projects/',
    meta: `${series.status}`,
  },
  {
    code: 'WARGAME',
    tone: 't-blue',
    text: '워게임 문제 풀이 — PHP 취약점, LFI, 세션 위조, SQL Injection',
    href: '/posts/?module=security&submodule=wargame',
    meta: `Wargame ${sub('security', 'wargame')}`,
  },
  {
    code: 'SYSTEM & INFRA',
    tone: 't-amber',
    text: 'Ubuntu · Debian, Docker, LXD, WSL 환경 구성과 SSH 오류 해결',
    href: '/posts/?module=infrastructure',
    meta: `Systems & Infrastructure ${mod('infrastructure')}`,
  },
];
---
<BaseLayout title="About" nav="profile" view="profile" description={`${SITE.author.name} — ${SITE.title}`}>
  <div class="grid-split reveal" data-pagefind-body>
    <span hidden data-pagefind-meta="type">PAGE</span>
    <span hidden data-pagefind-meta="sub">PROFILE · 소개</span>
    <HudPanel innerClass="p-6 p-pad flex flex-col justify-between">
      <div>
        <span class="panel-id">ID-01 // DEVELOPER PROFILE</span>
        <div class="mt-4 flex items-center gap-4">
          <div class="w-16 h-16 rounded-full bg-inset border-2 flex items-center justify-center font-hud text-2xl font-bold t-cyan shrink-0" style="border-color: var(--accent-primary)" aria-hidden="true">MQ</div>
          <div>
            <h1 class="font-hud text-2xl font-bold t-heading">{SITE.author.name}</h1>
            <p class="text-sm t-muted">{SITE.title} · {SITE.author.location}</p>
          </div>
        </div>
        <p class="mt-5 text-base t-body leading-relaxed">안녕하세요</p>
        <p class="mt-2 text-base t-body leading-relaxed">
          {SITE.author.bio} {SITE.author.name}의 블로그 「{SITE.title}」는 공부하고 실습한 내용을 정리해 두는 {SITE.description}입니다.
        </p>
      </div>
      <div class="mt-6 pt-4 border-t b-circuit-soft flex flex-wrap gap-2.5">
        <a href={SITE.author.github} rel="me noopener" class="btn-outline px-4 py-2 text-sm font-mono-code rounded">GITHUB -&gt;</a>
        <a href={SITE.author.email} class="btn-outline px-4 py-2 text-sm font-mono-code rounded">EMAIL -&gt;</a>
        <a href="/posts/" class="btn-outline px-4 py-2 text-sm font-mono-code rounded">BLOG ARCHIVE -&gt;</a>
      </div>
    </HudPanel>

    <section class="clean-card p-6 space-y-5" aria-labelledby="interests-title">
      <div>
        <span class="panel-id">CORE INTERESTS // 기록한 주제</span>
        <h2 id="interests-title" class="font-hud text-xl font-bold t-heading mt-1">주요 관심 분야</h2>
      </div>
      <ul class="grid-2">
        {
          interests.map((i) => (
            <li>
              <a href={i.href} class="block p-4 bg-inset border b-circuit-soft rounded h-full interest">
                <div class={`font-mono-code text-xs ${i.tone}`}>{i.code}</div>
                <p class="text-desc t-body mt-1.5">{i.text}</p>
                <p class="font-mono-code text-micro t-muted mt-2">{i.meta}</p>
              </a>
            </li>
          ))
        }
      </ul>
      <dl class="grid-kpi">
        <div class="kpi-tile"><dt class="font-mono-code text-micro t-muted">LOGS</dt><dd class="font-hud text-xl font-bold t-heading">{posts.length}</dd></div>
        <div class="kpi-tile"><dt class="font-mono-code text-micro t-muted">MODULES</dt><dd class="font-hud text-xl font-bold t-cyan">{stats.populated.length}</dd></div>
        <div class="kpi-tile"><dt class="font-mono-code text-micro t-muted">FIRST LOG</dt><dd class="font-mono-code text-sm t-heading mt-1">{formatDate(first.data.date)}</dd></div>
        <div class="kpi-tile"><dt class="font-mono-code text-micro t-muted">LATEST</dt><dd class="font-mono-code text-sm t-heading mt-1">{formatDate(latest.data.date)}</dd></div>
      </dl>
    </section>
  </div>
</BaseLayout>

<style>
  .interest:hover {
    border-color: var(--accent-primary);
  }
</style>
