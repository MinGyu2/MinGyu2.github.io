---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HudPanel from '../../components/hud/HudPanel.astro';
import ArchitectureDiagram from '../../components/projects/ArchitectureDiagram.astro';
import { PROJECTS } from '../../data/projects';
import { displayTitle, formatDate, getPosts } from '../../lib/posts';
import { getSeries } from '../../data/taxonomy';

const posts = await getPosts();
const [featured, ...others] = PROJECTS;
const series = featured.seriesId ? getSeries(featured.seriesId) : undefined;
const seriesPosts = series
  ? posts.filter((p) => p.data.series?.id === series.id).sort((a, b) => a.data.series!.order - b.data.series!.order)
  : [];
---
<BaseLayout title="Engineering Projects · 프로젝트" nav="projects" view="projects" description="직접 구현하고 기록한 엔지니어링 프로젝트와 아키텍처">
  <div class="space-y-6 reveal" data-pagefind-body>
    <span hidden data-pagefind-meta="type">PROJECT</span>
    <span hidden data-pagefind-meta="sub">PRJ · 엔지니어링 프로젝트 · 아키텍처</span>
    <HudPanel>
      <span class="panel-id">PRJ // ENGINEERING PROJECTS</span>
      <h1 class="font-hud text-2xl sm:text-3xl font-bold t-heading mt-1">엔지니어링 프로젝트</h1>
      <p class="text-desc t-muted mt-1.5">블로그에 기록한 구현 과정을 바탕으로, 직접 만든 시스템의 구성을 청사진으로 정리합니다.</p>
    </HudPanel>

    <HudPanel as="section" aria-labelledby={`${featured.id}-title`} innerClass="p-6 p-pad space-y-5">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div class="min-w-0">
          <div class="flex flex-wrap items-center gap-2 font-mono-code text-micro">
            <span class="t-cyan">{featured.code} // FEATURED</span>
            <span class="px-2 py-0.5 badge-amber rounded-sm">{featured.status}</span>
            <span class="px-2 py-0.5 rounded-sm border b-circuit t-mint" title={featured.verificationNote}>VERIFIED · 기록 기반</span>
          </div>
          <h2 id={`${featured.id}-title`} class="font-hud text-2xl font-bold t-heading mt-1.5">{featured.title}</h2>
          {featured.subtitle && <p class="text-desc t-cyan mt-0.5">{featured.subtitle}</p>}
          <p class="text-desc t-body mt-1.5 max-w-3xl">{featured.summary}</p>
          <ul class="mt-3 flex flex-wrap gap-1.5" aria-label="기술 스택">
            {featured.stack.map((s) => <li class="chip">{s}</li>)}
          </ul>
        </div>
        <div class="flex flex-wrap gap-2">
          {featured.links.map((l, i) => <a href={l.href} class={i === 0 ? 'btn-primary px-4 py-2 text-sm rounded' : 'btn-outline px-4 py-2 text-sm rounded'}>{l.label}</a>)}
        </div>
      </div>

      {featured.architecture && <ArchitectureDiagram id={featured.id} title={featured.title} nodes={featured.architecture} />}

      {
        featured.findings && featured.findings.length > 0 && (
          <section class="p-4 bg-inset border b-circuit rounded" aria-labelledby="findings-title">
            <h3 id="findings-title" class="font-mono-code text-micro t-amber mb-2">SECURITY EXERCISES // 기록된 실습 · 보완 사례</h3>
            <ul class="space-y-1.5 text-desc list-disc pl-5">
              {featured.findings.map((f) => (
                <li class="t-body">
                  <a href={f.href} class="link-cyan">{f.label}</a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <p class="text-meta t-muted">{featured.verificationNote}</p>

      {
        seriesPosts.length > 0 && (
          <details class="bg-inset border b-circuit rounded">
            <summary class="px-4 py-3 cursor-pointer text-sm font-semibold t-heading min-h-11">
              {series?.title} · 연재 전체 목록 ({seriesPosts.length}편)
            </summary>
            <p class="px-4 pb-2 text-meta">
              <a href={`/posts/?series=${series?.id}`} class="link-cyan">기술 게시글에서 연재만 모아 보기 -&gt;</a>
            </p>
            <ol class="px-4 pb-4 space-y-1.5 list-decimal list-inside text-desc">
              {seriesPosts.map((p) => (
                <li class="t-muted">
                  <a href={p.data.legacyPath} class="t-body hover:text-[var(--accent-primary)]">{displayTitle(p)}</a>
                  <time class="font-mono-code text-micro ml-2" datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
                </li>
              ))}
            </ol>
          </details>
        )
      }
    </HudPanel>

    <div class="grid-2">
      {
        others.map((p) => (
          <section class="clean-card p-5" aria-labelledby={`${p.id}-title`}>
            <div class="flex flex-wrap items-center justify-between gap-2 font-mono-code text-micro mb-2">
              <span class="t-blue">{p.code}</span>
              <span class="t-mint">{p.status}</span>
            </div>
            <h2 id={`${p.id}-title`} class="font-hud text-xl font-bold t-heading">{p.title}</h2>
            <p class="text-desc t-body mt-2">{p.summary}</p>
            <ul class="mt-4 flex flex-wrap gap-1.5" aria-label="기술 스택">
              {p.stack.map((s) => <li class="chip">{s}</li>)}
            </ul>
            <div class="mt-4 flex flex-wrap gap-3 text-sm">
              {p.links.map((l) => <a href={l.href} class="link-cyan">{l.label} -&gt;</a>)}
            </div>
          </section>
        ))
      }
    </div>
  </div>
</BaseLayout>
