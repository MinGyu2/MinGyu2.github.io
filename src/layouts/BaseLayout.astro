---
import '../styles/global.css';
import SiteHeader from '../components/navigation/SiteHeader.astro';
import SiteFooter from '../components/navigation/SiteFooter.astro';
import SearchPalette from '../components/navigation/SearchPalette.astro';
import CircuitDecor from '../components/hud/CircuitDecor.astro';
import { SITE, absoluteUrl, type NavId } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  nav?: NavId;
  view?: 'command' | 'logs' | 'reader' | 'modules' | 'projects' | 'lab' | 'profile' | 'plain';
  type?: 'website' | 'article';
  article?: { published: Date; modified?: Date; tags?: string[]; section?: string };
  noindex?: boolean;
}
const { title, description = SITE.description, nav, view = 'plain', type = 'website', article, noindex = false } = Astro.props;
const fullTitle = title ? `${title} - ${SITE.title}` : `ARC LAB // ${SITE.title}`;
const canonical = absoluteUrl(Astro.url.pathname);
const isProd = import.meta.env.PROD;
---
<!doctype html>
<html lang="ko" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author.name} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content={type} />
    <meta property="og:locale" content={SITE.ogLocale} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:url" content={canonical} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    {
      article && (
        <>
          <meta property="article:author" content={SITE.author.name} />
          <meta property="article:published_time" content={article.published.toISOString()} />
          {article.modified && <meta property="article:modified_time" content={article.modified.toISOString()} />}
          {article.section && <meta property="article:section" content={article.section} />}
          {article.tags?.map((t) => <meta property="article:tag" content={t} />)}
        </>
      )
    }
    <link rel="alternate" type="application/atom+xml" href="/feed.xml" title={`${SITE.title} Feed`} />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#070d14" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#eef2f5" media="(prefers-color-scheme: light)" />
    <meta name="generator" content={Astro.generator} />
    <!-- Theme: saved choice, else system preference. Runs before first paint (no flash). -->
    <script is:inline>
      (function () {
        var t = null;
        try { t = localStorage.getItem('arc_lab_theme'); } catch (e) {}
        if (t !== 'dark' && t !== 'light') {
          t = window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        }
        document.documentElement.setAttribute('data-theme', t);
        document.documentElement.classList.add('js');
      })();
    </script>
    {
      isProd && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.analytics.gtagId}`} />
          <script is:inline define:vars={{ id: SITE.analytics.gtagId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            gtag('js', new Date());
            gtag('config', id);
          </script>
        </>
      )
    }
    <slot name="head" />
  </head>
  <body class="antialiased">
    <a class="skip-link" href="#main-content">본문으로 건너뛰기</a>
    <div class="site-canvas" data-view={view}>
      <CircuitDecor />
      <SiteHeader active={nav} />
      <slot name="before-main" />
      <main id="main-content" class="relative z-10 page-pad max-w-7xl mx-auto min-h-[calc(100vh-11rem)]" tabindex="-1">
        <slot />
      </main>
      <SiteFooter />
    </div>
    <SearchPalette />
    <div id="toast" class="toast" role="status" aria-live="polite" hidden>
      <span class="w-2 h-2 rounded-full" style="background: var(--accent-primary)" aria-hidden="true"></span>
      <span data-toast-msg></span>
    </div>
    <script>
      import { watchSystemTheme } from '../scripts/theme';
      watchSystemTheme();
    </script>
  </body>
</html>
